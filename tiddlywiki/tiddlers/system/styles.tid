title: $:/is/styles
tags: $:/tags/Stylesheet
type: text/css

/* Tokens shared with web/src/style.css: warm neutrals, one green accent, OS light/dark. Palette $:/is/palette points here. */
:root {
  --is-page: #fbfaf7; --is-surface: #ffffff; --is-fg: #22201c; --is-muted: #6f6a60; --is-faint: #a9a49a; --is-border: #e4e0d8;
  --is-subtle: #f3f1ec; --is-accent: #2f7a5b; --is-on-accent: #ffffff; --is-warn: #8a5a00; --is-warn-bg: #fbefd3; --is-danger: #b3362b;
  color-scheme: light dark;
}
@media (prefers-color-scheme: dark) {
  :root { --is-page: #16181a; --is-surface: #1e2124; --is-fg: #e6e3dc; --is-muted: #9a958b; --is-faint: #6b675f; --is-border: #2e3236;
    --is-subtle: #25292c; --is-accent: #6fcf9f; --is-on-accent: #10130f; --is-warn: #e2b250; --is-warn-bg: #3a2f17; --is-danger: #ef7d70; }
}
html body.tc-body { background: var(--is-page); }
.tc-tiddler-frame { border: 1px solid var(--is-border); border-radius: 6px; box-shadow: none; }
.tc-tiddler-body { overflow-wrap: anywhere; }
.tc-tiddler-body h1, .tc-tiddler-body h2 { border-bottom: 1px solid var(--is-border); padding-bottom: 2px; }
.tc-tiddler-body h2 { font-size: 1.35em; } .tc-tiddler-body h3 { font-size: 1.15em; }
a.tc-tiddlylink-external, a.tc-tiddlylink-external:visited { color: var(--is-accent); }
.tc-tag-label, button.tc-tag-label, .tc-tag-label svg { color: var(--is-fg) !important; fill: var(--is-fg) !important; background: var(--is-subtle) !important; border: 1px solid var(--is-border); }
.tc-site-title { font-weight: 600; } .tc-site-subtitle { color: var(--is-muted); }

/* Tables: scroll inside their own box, never the page; ServiceNow-style list rows. */
.tc-tiddler-body table { display: block; width: max-content; max-width: 100%; overflow-x: auto; border-collapse: collapse; font-size: 13px; line-height: 1.35; margin: 0.5em 0 1em; }
.tc-tiddler-body table th, .tc-tiddler-body table td { border: 1px solid var(--is-border); padding: 3px 8px; vertical-align: top; }
.tc-tiddler-body table th { background: var(--is-subtle); text-align: left; font-weight: 600; }
.tc-tiddler-body table tr.evenRow, .tc-tiddler-body table tr.oddRow { background: none; }
.tc-tiddler-body table tbody tr:hover td { background: color-mix(in srgb, var(--is-fg) 5%, transparent); }
.tc-tiddler-body td > p:only-child, .tc-tiddler-body th > p:only-child, summary > p { margin: 0; display: inline; }
.tc-tiddler-body p:has(> table) { margin: 0; }
.is-tablewrap { max-height: 70vh; overflow: auto; border: 1px solid var(--is-border); border-radius: 6px; margin: 0.5em 0 1em; background: var(--is-surface); }
.is-tablewrap table.is-list { display: table; margin: 0; width: 100%; }
table.is-list th { position: sticky; top: 0; z-index: 1; white-space: nowrap; border-width: 0 0 1px 0; }
table.is-list td { border-width: 0 0 1px 0; }
table.is-list th.is-sorted { color: var(--is-accent); }
table.is-list .is-sort { font-weight: 600; color: inherit; text-align: left; }
.tc-tiddler-body td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
table.is-fields { display: table; } table.is-fields th { width: 12em; }

/* Converted-markup markers */
.mw-img { display: inline-block; font-size: 11px; line-height: 1.3; padding: 0 4px; margin: 1px 2px; border: 1px dashed var(--is-faint); border-radius: 3px; color: var(--is-muted); white-space: nowrap; }
.mw-img-caption { color: var(--is-muted); font-style: italic; }
.mw-raw { font-family: ui-monospace, Consolas, monospace; font-size: 12px; background: var(--is-warn-bg); color: var(--is-fg); border: 1px dashed var(--is-warn); border-radius: 3px; padding: 0 3px; white-space: pre-wrap; }
pre.mw-raw { display: block; padding: 6px 8px; }
.mw-center { text-align: center; }
details.mw-collapsible { border: 1px solid var(--is-border); border-radius: 6px; padding: 4px 10px; margin: 0.5em 0; background: var(--is-surface); }
details.mw-collapsible > summary { cursor: pointer; font-weight: 600; color: var(--is-accent); }
.mw-toggle { color: var(--is-accent); text-decoration: underline; cursor: pointer; }
.fp-icon { display: inline-block; margin: 2px 10px 2px 0; }
.fpbox { border: 1px solid var(--is-border); border-radius: 6px; padding: 4px 10px; margin: 6px 0; }
.mw-cn, .mw-ref { color: var(--is-muted); }

/* Page chrome */
.is-source, .is-note, .is-count { color: var(--is-muted); font-size: 12px; }
.is-source { border-top: 1px solid var(--is-border); margin-top: 1.5em; padding-top: 6px; }
.is-children { margin-top: 1em; }
.is-children ul { columns: 14em; padding-left: 1.2em; margin: 4px 0; }
.is-label { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--is-muted); }
.is-toolbar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 0.5em 0; }
.is-input { padding: 4px 8px; border: 1px solid var(--is-border); border-radius: 4px; background: var(--is-surface); color: var(--is-fg); min-width: 12em; }
textarea.is-save { width: 100%; height: 8em; font-family: ui-monospace, Consolas, monospace; font-size: 12px; }
.is-attrib { font-size: 12px; color: var(--is-muted); border-top: 1px solid var(--is-border); padding-top: 8px; margin-top: 12px; }
.is-toc ol { list-style: none; padding-left: 1em; margin: 0; }
.is-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; max-width: 720px; margin: 0.5em 0 1em; }
.is-tile { border: 1px solid var(--is-border); border-radius: 6px; background: var(--is-surface); padding: 8px 12px; }
.is-tile b { display: block; font-size: 20px; font-variant-numeric: tabular-nums; }
.is-tile span { color: var(--is-muted); font-size: 12px; }
.tc-tiddler-body table td, .tc-tiddler-body table th { overflow-wrap: normal; word-break: normal; }
table.is-fields th { text-align: left; }
